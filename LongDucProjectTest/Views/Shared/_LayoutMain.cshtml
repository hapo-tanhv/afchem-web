
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>SOL Solar SCADA</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/fontawesome-free/css/all.min.css">
    <!-- Ionicons -->
    <link rel="stylesheet" href="https://code.ionicframework.com/ionicons/2.0.1/css/ionicons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <!-- Tempusdominus Bootstrap 4 -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/tempusdominus-bootstrap-4/css/tempusdominus-bootstrap-4.min.css">
    <!-- iCheck -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/icheck-bootstrap/icheck-bootstrap.min.css">
    <!-- JQVMap -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/jqvmap/jqvmap.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/AdminLTE-master/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/AdminLTE-master/dist/css/adminlte.css">
    <!-- Toastr -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/toastr/toastr.min.css">
    <!-- overlayScrollbars -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <!-- Daterange picker -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/daterangepicker/daterangepicker.css">
    <!-- summernote -->
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/summernote/summernote-bs4.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <style>
        /* ==================================================================
           1. LAYOUT TỔNG THỂ
           ================================================================== */
        body { background-color: #0a0a0a; font-family: 'Source Sans Pro', sans-serif; }

        .main-header {
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
            background-color: #0f172a !important;
            border-bottom: 0.0625rem solid rgba(255,255,255,0.1) !important;
            height: 4.0625rem;
            padding: 0 1.25rem !important;
            margin-left: 0 !important;
            position: sticky;
            top: 0;
            z-index: 1035 !important;
        }

        /* ==================================================================
           2. BRANDING (BÊN TRÁI)
           ================================================================== */
        .header-left-group { display: flex; align-items: center; gap: 0.9375rem; }
        .brand-wrapper { display: flex !important; align-items: center !important; gap: 0.75rem; }
        .brand-text-content { display: flex !important; flex-direction: column !important; line-height: 1.1 !important; }
        .brand-text-content .main-title { color: #ffffff !important; font-weight: 700; font-size: 1rem; letter-spacing: 0.0312rem; margin: 0 !important; }
        .brand-text-content .sub-title {
            color: #e7ecf3 !important;
            font-size: 0.625rem;
            text-transform: uppercase;
            margin: 0 !important;
        }

        /* ==================================================================
           3. KHỐI TIỆN ÍCH (BÊN PHẢI)
           ================================================================== */
        .header-right-group { display: flex; align-items: center; gap: 1.875rem; }

        /* PLC Status - Dạng Card như ảnh 2 */
        .plc-status-card {
            border: 0.0625rem solid rgba(255,255,255,0.1);
            background: rgba(15, 23, 42, 0.5);
            border-radius: 0.5rem;
            padding: 0.3125rem 0.9375rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            min-width: 8.75rem;
        }
        .status-indicator { display: flex; flex-direction: column; }
        .status-label { color: #94a3b8; font-size: 0.625rem; text-transform: uppercase; font-weight: 600; margin-bottom: -0.125rem; }
        .status-text { color: #22c55e; font-size: 0.8125rem; font-weight: 700; }
        .dot-online { width: 0.75rem; height: 0.75rem; background: #22c55e; border-radius: 50%; box-shadow: 0 0 0.625rem #22c55e; animation: pulse 2s infinite; }

        /* Realtime Clock - Chia 2 dòng */
        .clock-wrapper { display: flex; align-items: center; gap: 0.75rem; color: #e2e8f0; }
        .clock-icon { font-size: 1.25rem; color: #94a3b8; }
        .clock-data { display: flex; flex-direction: column; line-height: 1.1; }
        .clock-time { font-size: 0.875rem; color: #ffffff; }
        .clock-date {
            font-size: 0.6875rem;
            color: #a9b7cb;
        }

        /* Notification */
        .notification-btn { position: relative; color: #94a3b8; font-size: 1.25rem; transition: 0.3s; }
        .notification-btn:hover { color: #ffffff; }
        .badge-count {
            position: absolute; top: -0.3125rem; right: -0.3125rem; background: #ef4444;
            color: white; font-size: 0.625rem; padding: 0.0625rem 0.3125rem; border-radius: 50%;
            border: 0.125rem solid #0f172a;
        }

        /* User Profile */
        .user-profile-toggle { display: flex; align-items: center; gap: 0.75rem; cursor: pointer; padding-left: 1.25rem; border-left: 0.0625rem solid rgba(255,255,255,0.1); }
        .user-meta { display: flex; flex-direction: column; text-align: right; line-height: 1.1; }
        .u-name { color: #ffffff; font-size: 0.8125rem; font-weight: 700; }
        .u-role {
            color: #a9b7cb;
            font-size: 0.6875rem;
        }
        .u-avatar { width: 2.375rem; height: 2.375rem; border-radius: 50%; border: 0.0625rem solid #334155; object-fit: cover; }

        /* Dropdown Menu */
        .user-dropdown-menu { background-color: #1e293b !important; border: 0.0625rem solid rgba(255,255,255,0.1) !important; border-radius: 0.5rem !important; margin-top: 0.9375rem !important; box-shadow: 0 0.625rem 1.5625rem rgba(0,0,0,0.5) !important; }
        .user-dropdown-menu .dropdown-item { color: #e2e8f0 !important; padding: 0.625rem 1.25rem !important; font-size: 0.875rem; }
        .user-dropdown-menu .dropdown-item:hover { background-color: #334155 !important; color: #ffffff !important; }

        /* Notification Dropdown */
        .notification-dropdown {
            width: 18.75rem;
            background-color: #1e293b !important;
            border: 0.0625rem solid rgba(255,255,255,0.1) !important;
            border-radius: 0.5rem !important;
            margin-top: 0.9375rem !important;
            box-shadow: 0 0.625rem 1.5625rem rgba(0,0,0,0.5) !important;
            padding: 0;
        }
        .notification-dropdown .dropdown-item {
            color: #e2e8f0 !important;
            border-bottom: 0.0625rem solid rgba(255,255,255,0.05);
            padding: 0.75rem 0.9375rem !important;
        }
        .notification-dropdown .dropdown-item:hover {
            background-color: #334155 !important;
        }
        .notification-dropdown .dropdown-item:last-child {
            border-bottom: none;
        }
        .notification-header {
            padding: 0.9375rem;
            border-bottom: 0.0625rem solid rgba(255,255,255,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .notification-header-title { color: #ffffff; font-weight: 600; }
        .notification-header-link { color: #3b82f6; font-size: 0.75rem; }
        .notification-body { max-height: 18.75rem; overflow-y: auto; }
        .notification-footer {
            padding: 0.75rem;
            border-top: 0.0625rem solid rgba(255,255,255,0.1);
            text-align: center;
        }
        .notification-footer a { color: #3b82f6; font-size: 0.8125rem; }

        /* Machine Info Bar - Theo thiết kế ảnh header.png */
        .machine-info-bar {
            display: flex;
            align-items: center;
            gap: 0;
            padding: 0.5rem 1rem;
        }

        .machine-info-bar .divider {
            width: 0.0625rem;
            height: 2.25rem;
            background: rgba(255,255,255,0.1);
            margin: 0 0.5rem;
        }

        /* Machine Select Custom */
        .machine-select-custom {
            position: relative;
            min-width: 10rem;
        }

        .selected-machine {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem;
            background: rgba(15, 23, 42, 0.6);
            border: 0.0625rem solid rgba(59, 130, 246, 0.25);
            border-radius: 0.375rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .selected-machine:hover {
            background: rgba(15, 23, 42, 0.8);
            border-color: rgba(59, 130, 246, 0.4);
        }

        .selected-machine .machine-icon {
            color: #00e5ff;
            font-size: 0.875rem;
        }

        .selected-machine .machine-text {
            color: #00e5ff;
            font-size: 0.875rem;
            font-weight: 600;
        }

        .selected-machine .machine-text span {
            color: #00e5ff;
        }

        .selected-machine .dropdown-arrow {
            color: #00e5ff;
            font-size: 0.625rem;
            margin-left: auto;
            transition: transform 0.2s ease;
        }

        .selected-machine.active .dropdown-arrow {
            transform: rotate(180deg);
        }

        .machine-options {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            margin-top: 0.25rem;
            background: #0f172a;
            border: 0.0625rem solid rgba(59, 130, 246, 0.3);
            border-radius: 0.375rem;
            overflow: hidden;
            z-index: 1000;
            box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.3);
        }

        .machine-options.show {
            display: block;
        }

        .machine-option {
            padding: 0.625rem 0.75rem;
            color: #ffffff;
            font-size: 0.8125rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .machine-option:hover {
            background: rgba(59, 130, 246, 0.15);
        }

        .machine-option.selected {
            background: rgba(59, 130, 246, 0.25);
            color: #3b82f6;
        }

        .machine-info-bar .info-item {
            display: flex;
            flex-direction: column;
            gap: 0.1875rem;
            padding: 0.375rem 0.75rem;
        }

        .info-item .shift-value {
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
        }

        .machine-info-bar .info-label {
            font-size: 0.8125rem;
            color: #a9b7cb;
            font-weight: 600;
        }

        .machine-info-bar .info-value {
            font-size: 1rem;
            color: #00e5ff;
            font-weight: 700;
        }

        .machine-info-bar .machine-status {
            font-size: 0.6875rem;
            font-weight: 700;
            padding: 0.1875rem 0.625rem;
            border-radius: 0.25rem;
            display: inline-block;
        }

        .machine-info-bar .machine-status.running {
            color: #22c55e;
            font-size: 1rem;
        }

        .machine-info-bar .production-value {
            display: flex;
            align-items: center;
            gap: 0.1875rem;
            font-size: 1rem;
            color: #ffffff;
            font-weight: 700;
        }

        .machine-info-bar .production-value .current-value {
            color: #00e5ff;
        }

        .machine-info-bar .production-value .sep {
            color: #475569;
            font-weight: 500;
        }

        .machine-info-bar .runtime-value {
            font-size: 1rem;
            color: #00e5ff;
            font-weight: 700;
        }

        .machine-info-bar .alarm-item {
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .machine-info-bar .alarm-item:hover {
            background: rgba(239, 68, 68, 0.1);
            border-radius: 0.375rem;
        }

        .machine-info-bar .alarm-item .alarm-count {
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }

        .machine-info-bar .alarm-item .alarm-bell {
            color: #f59e0b;
            font-size: 1rem;
            animation: bell-shake 2s infinite;
        }

        @@keyframes bell-shake {
            0%, 100% { transform: rotate(0deg); }
            10% { transform: rotate(-5deg); }
            20% { transform: rotate(5deg); }
            30% { transform: rotate(-5deg); }
            40% { transform: rotate(5deg); }
            50% { transform: rotate(0deg); }
        }

        .machine-info-bar .alarm-item .alarm-badge {
            color: #f59e0b;
            font-size: 1rem;
            font-weight: 600;
        }

        .machine-info-bar .sub-stage {
            padding: 0.375rem 0.375rem;
            margin-left: -0.625rem;
        }

        .machine-info-bar .sub-stage .sub-stage-label {
            font-size: 0.625rem;
            color: #3b82f6;
            font-weight: 600;
            background: rgba(59, 130, 246, 0.1);
            padding: 0.125rem 0.5rem;
            border-radius: 0.25rem;
            border: 0.0625rem solid rgba(59, 130, 246, 0.2);
        }

        /* Machine Clock trong info bar */
        .machine-clock {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.375rem 0.75rem;
        }

        .machine-clock i {
            color: #00e5ff;
            font-size: 0.875rem;
        }

        .machine-clock .clock-data {
            display: flex;
            flex-direction: column;
            font-weight: 600;
        }
        .machine-clock .clock-time {
            color: #ffffff;
            font-size: 0.875rem;
        }

        .machine-clock .clock-date {
            color: #ffffff;
            font-size: 0.875rem;
        }

        /* ==================================================================
           4. RESPONSIVE HEADER MACHINE INFO BAR (FONT & PADDING SCALING)
           ================================================================== */
        @@media (max-width: 100rem) {
            .main-header {
                padding: 0 0.9375rem !important;
            }
            .header-right-group {
                gap: 1.25rem;
            }
            .machine-info-bar {
                padding: 0.375rem 0.625rem;
            }
            .machine-info-bar .divider {
                margin: 0 0.375rem;
            }
            .machine-info-bar .info-item {
                padding: 0.25rem 0.5rem;
            }
            .machine-info-bar .info-label {
                font-size: 0.75rem;
            }
            .machine-info-bar .info-value,
            .info-item .shift-value,
            .machine-info-bar .machine-status.running,
            .machine-info-bar .production-value,
            .machine-info-bar .runtime-value,
            .machine-info-bar .alarm-item .alarm-badge {
                font-size: 0.875rem;
            }
            .selected-machine {
                padding: 0.5rem 0.625rem;
            }
            .selected-machine .machine-text {
                font-size: 0.8125rem;
            }
            .machine-select-custom {
                min-width: 8.75rem;
            }
            .machine-clock {
                padding: 0.25rem 0.5rem;
            }
            .machine-clock .clock-time,
            .machine-clock .clock-date {
                font-size: 0.8125rem;
            }
            .user-profile-toggle {
                padding-left: 0.9375rem;
                gap: 0.5rem;
            }
            .u-avatar {
                width: 2.125rem;
                height: 2.125rem;
            }
        }

        @@media (max-width: 87.5rem) {
            .main-header {
                padding: 0 0.625rem !important;
            }
            .header-right-group {
                gap: 0.75rem;
            }
            .machine-info-bar {
                padding: 0.25rem 0.375rem;
            }
            .machine-info-bar .divider {
                margin: 0 0.25rem;
            }
            .machine-info-bar .info-item {
                padding: 0.1875rem 0.375rem;
            }
            .machine-info-bar .info-label {
                font-size: 0.6875rem;
            }
            .machine-info-bar .info-value,
            .info-item .shift-value,
            .machine-info-bar .machine-status.running,
            .machine-info-bar .production-value,
            .machine-info-bar .runtime-value,
            .machine-info-bar .alarm-item .alarm-badge {
                font-size: 0.8125rem;
            }
            .selected-machine {
                padding: 0.375rem 0.5rem;
            }
            .selected-machine .machine-text {
                font-size: 0.75rem;
            }
            .machine-select-custom {
                min-width: 7.5rem;
            }
            .user-profile-toggle {
                padding-left: 0.625rem;
                gap: 0.375rem;
            }
            .u-avatar {
                width: 1.875rem;
                height: 1.875rem;
            }
            .u-name {
                font-size: 0.75rem;
            }
            .u-role {
                font-size: 0.625rem;
            }
            
            /* Ẩn bớt Clock để tránh chật chội */
            .header-clock, .divider-alarm {
                display: none !important;
            }
        }

        @@media (max-width: 78.125rem) {
            /* Ẩn Ca làm việc và Sản lượng */
            .header-shift, .divider-shift,
            .header-output, .divider-output {
                display: none !important;
            }
        }

        @@media (max-width: 70rem) {
            /* Ẩn thời gian chạy và số mẻ */
            .header-runtime, .divider-runtime,
            .header-batch, .divider-batch {
                display: none !important;
            }
        }

        @@media (max-width: 62rem) {
            /* Ẩn trạng thái máy và Chọn máy, chỉ giữ lại Công đoạn và Cảnh báo */
            .header-status, .divider-status,
            .header-machine-select, .divider-machine-select {
                display: none !important;
            }
        }

        @@media (max-width: 48rem) {
            .machine-info-bar {
                display: none !important;
            }
        }

        .notif-item { display: flex; gap: 0.75rem; }
        .notif-icon {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }
        .notif-icon.danger { background: rgba(239, 68, 68, 0.2); }
        .notif-icon.danger i { color: #ef4444; }
        .notif-icon.success { background: rgba(34, 197, 94, 0.2); }
        .notif-icon.success i { color: #22c55e; }
        .notif-icon.warning { background: rgba(245, 158, 11, 0.2); }
        .notif-icon.warning i { color: #f59e0b; }
        .notif-icon.info { background: rgba(59, 130, 246, 0.2); }
        .notif-icon.info i { color: #3b82f6; }
        .notif-title { color: #ffffff; font-size: 0.8125rem; font-weight: 500; }
        .notif-desc {
            color: #a9b7cb;
            font-size: 0.6875rem;
        }
        .notif-time { color: #475569; font-size: 0.625rem; margin-top: 0.25rem; }

        /* Sidebar & Content */
        .main-sidebar {
            padding-top: 4.6875rem !important;
            z-index: 1030 !important;
            background-color: #131c2f !important;
            overflow-y: auto !important;
            -ms-overflow-style: none !important;  /* IE and Edge */
            scrollbar-width: none !important;  /* Firefox */
        }
        .main-sidebar::-webkit-scrollbar,
        .sidebar::-webkit-scrollbar {
            display: none !important;
        }
        .sidebar {
            -ms-overflow-style: none !important;  /* IE and Edge */
            scrollbar-width: none !important;  /* Firefox */
        }

        /* Hide sidebar footer when collapsed */
        body.sidebar-collapse .sidebar-brand-footer {
            display: none !important;
        }

        @@media (max-width: 36rem) {
            .brand-text-content .sub-title {
                display: none !important;
            }
            .brand-text-content .main-title {
                font-size: 0.875rem !important;
            }
        }

        /* Căn chỉnh lại List Menu */
        .nav-sidebar {
            padding: 0 0.625rem !important;
        }

        .nav-sidebar .nav-item {
            margin-bottom: 0.5rem !important;
        }

        /* Style cơ bản cho các Link menu */
        .nav-sidebar .nav-link {
            color: #94a3b8 !important;
            border-radius: 0.625rem !important; /* Bo góc item */
            padding: 0.75rem 0.9375rem !important;
            transition: all 0.3s ease;
            border: none !important;
        }

        /* HOVER: Lớp phủ nhẹ */
        .nav-sidebar .nav-link:hover {
            background-color: rgba(255, 255, 255, 0.05) !important;
            color: #ffffff !important;
        }

        /* ACTIVE PART: Khớp hoàn toàn ảnh 2 */
        .nav-sidebar .nav-item .nav-link.active {
            background: linear-gradient(90deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.3) 100%) !important;
            color: #ffffff !important;
            position: relative;
            box-shadow: none !important;
        }

        /* Vạch xanh Cyan bên trái cho phần Active */
        .nav-sidebar .nav-item .nav-link.active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 15%;
            height: 70%;
            width: 0.25rem;
            background-color: #00e5ff; /* Màu Cyan đặc trưng */
            border-radius: 0 0.25rem 0.25rem 0;
            box-shadow: 0 0 0.625rem rgba(0, 229, 255, 0.6);
        }

        /* Icon Active */
        .nav-sidebar .nav-link.active i {
            color: #00e5ff !important;
            filter: drop-shadow(0 0 0.3125rem rgba(0, 229, 255, 0.4));
        }

        /* Sidebar Footer Text */
        .sidebar-brand-footer {
            position: absolute;
            bottom: 1.875rem;
            width: 100%;
            text-align: center;
            left: 0;
        }

        .sidebar-brand-footer span {
            color: #475569;
            font-size: 0.75rem;
            letter-spacing: 0.0625rem;
            font-weight: 500;
        }

        /* Sửa lỗi hiển thị Dropdown và các thành phần khác của AdminLTE */
        .content-wrapper {
            background-color: #0a0a0a !important;
        }

        .nav-sidebar .nav-link p {
            margin-left: 0.625rem;
        }

        @@keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
            70% { box-shadow: 0 0 0 0.5rem rgba(34, 197, 94, 0); }
            100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <nav class="main-header navbar navbar-expand navbar-dark">
            <div class="header-left-group">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button" style="color: #94a3b8; font-size: 1.125rem; padding: 0 0.625rem; margin-right: 0.3125rem; display: inline-block;">
                    <i class="fas fa-bars"></i>
                </a>
                <div class="brand-wrapper">
                    <img src="~/Image/afchem_logo.png" style="height: 2.1875rem;" alt="Logo">
                    <div class="brand-text-content">
                        <span class="main-title">AFCHEM SYSTEM</span>
                        <span class="sub-title">SCADA MONITORING</span>
                    </div>
                </div>
            </div>

            <div class="header-right-group">
                <!-- Machine Info - Theo thiết kế ảnh header.png -->
                <div class="machine-info-bar d-none d-md-flex">
                    <!-- Machine Select Custom -->
                    <div class="machine-select-custom header-machine-select" id="machineSelectContainer">
                        <div class="selected-machine" onclick="toggleMachineDropdown()">
                            <i class="fas fa-industry machine-icon"></i>
                            <span class="machine-text">Chọn máy: <span id="selectedMachineName">TX01</span></span>
                            <i class="fas fa-chevron-down dropdown-arrow"></i>
                        </div>
                        <div class="machine-options" id="machineOptions">
                            <div class="machine-option" onclick="selectMachine('TX01')">TX01</div>
                        </div>
                    </div>
                    <div class="divider divider-machine-select"></div>
                    <!-- Status -->
                    <!-- Batch -->
                    <div class="info-item header-batch">
                        <span class="info-label">Batch</span>
                        <span class="info-value" id="headerBatchNumber">2</span>
                    </div>
                    <div class="divider divider-batch"></div>
                    <div class="info-item header-step">
                        <span class="info-label">Công đoạn</span>
                        <span class="info-value" id="step">Rung xả hàng</span>
                    </div>
                    <div class="divider divider-step"></div>
                    <div class="info-item header-status">
                        <span class="info-label">Trạng thái máy</span>
                        <span class="machine-status running" id="headerMachineStatus">RUNNING</span>
                    </div>
                    <div class="divider divider-status"></div>
                    <!-- Output -->
                    <div class="info-item header-output">
                        <span class="info-label">Sản lượng hiện tại / Mục tiêu</span>
                        <div class="production-value">
                            <span class="current-value" id="headerCurrentOutput">1000</span>
                            <span class="sep">/</span>
                            <span id="headerTargetOutput">2000</span>
                        </div>
                    </div>
                    <div class="divider divider-output"></div>
                    <!-- Runtime -->
                    <div class="info-item header-runtime">
                        <span class="info-label">Thời gian chạy</span>
                        <span class="runtime-value" id="headerRunningTime">0s</span>
                    </div>
                    <div class="divider divider-runtime"></div>
                    <!-- Shift -->
                    <div class="info-item header-shift">
                        <span class="info-label">Ca hiện tại</span>
                        <span class="shift-value" id="headerCurrentShift">8:00 - 12:00</span>
                    </div>
                    <div class="divider divider-shift"></div>
                    <!-- Alarm -->
                    <div class="info-item alarm-item header-alarm" onclick="openAlarmPage()">
                        <span class="info-label">Cảnh báo</span>
                        <div class="alarm-count">
                            <i class="fas fa-bell alarm-bell"></i>
                            <span class="alarm-badge" id="alarmCount">5</span>
                        </div>
                    </div>
                    <div class="divider divider-alarm"></div>
                    <!-- Clock -->
                    <div class="machine-clock header-clock">
                        <i class="far fa-clock"></i>
                        <div class="clock-data">
                            <span id="txtDate" class="clock-date">28/10/2023</span>
                            <span id="txtTime" class="clock-time">04:50:26</span>
                        </div>
                    </div>
                </div>

                <div class="dropdown">
                    <div class="user-profile-toggle" data-toggle="dropdown">
                        <div class="user-meta d-none d-sm-flex">
                            <span class="u-name">@(Session["UserName"] != null ? Session["UserName"].ToString() : "Admin")</span>
                        </div>
                        <img src="~/AdminLTE-master/dist/img/user2-160x160.jpg" class="u-avatar" alt="User">
                        <i class="fas fa-angle-down" style="color: #a9b7cb; font-size: 0.6875rem;"></i>
                    </div>
                    <div class="dropdown-menu dropdown-menu-right user-dropdown-menu">
                        <a class="dropdown-item" href="#"><i class="fas fa-user-circle mr-2"></i> Thông tin cá nhân</a>
                        <div class="dropdown-divider" style="border-top: 0.0625rem solid rgba(255,255,255,0.05);"></div>
                        <a class="dropdown-item" href="@Url.Action("Logout", "Home")" style="color: #ef4444 !important;">
                            <i class="fas fa-sign-out-alt mr-2"></i> Đăng xuất
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <aside class="main-sidebar">
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">

                        <li class="nav-item">
                            <a href="~/Home/Overview" class="nav-link @(ViewBag.ButtonHome)">
                                <i class="nav-icon fas fa-th-large"></i>
                                <p>Tổng quan</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="~/Home/Alarm" class="nav-link @(ViewBag.ButtonAlarm)">
                                <i class="nav-icon fas fa-exclamation-triangle"></i>
                                <p>
                                    Cảnh báo
                                    <span class="right badge" id="sidebarAlarmCount" style="font-size: 1rem; color: #f59e0b;">0</span>
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="~/Home/Event" class="nav-link @(ViewBag.ButtonEvent)">
                                <i class="nav-icon fas fa-calendar"></i>
                                <p>Batches</p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="~/Home/Report" class="nav-link @(ViewBag.ButtonReport)">
                                <i class="nav-icon fas fa-file-alt"></i>
                                <p>Báo cáo</p>
                            </a>
                        </li>

                        @if (Session["Role"] != null && (int)Session["Role"] == (int)Hino.Getdata.Common.Role.Admin)
                        {
                            <li class="nav-item">
                                <a href="~/Home/UserSetting" class="nav-link @(ViewBag.ButtonUser)">
                                    <i class="nav-icon fas fa-cog"></i>
                                    <p>Cài đặt hệ thống</p>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>

                <div class="sidebar-brand-footer">
                    <span>© 2026 HAPOSOFT</span>
                </div>
            </div>
        </aside>

        <div class="content-wrapper">
            @RenderBody()
        </div>
    </div>
    <!-- ./wrapper -->
    <!-- jQuery -->
    <script src="~/AdminLTE-master/plugins/jquery/jquery.min.js"></script>
    <!-- jQuery UI 1.11.4 -->
    <script src="~/AdminLTE-master/plugins/jquery-ui/jquery-ui.min.js"></script>
    <!-- Resolve conflict in jQuery UI tooltip with Bootstrap tooltip -->
    <script>$.widget.bridge('uibutton', $.ui.button)</script>
    <!-- Bootstrap 4 -->
    <script src="~/AdminLTE-master/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- ChartJS -->
    <script src="~/AdminLTE-master/plugins/chart.js/Chart.min.js"></script>
    <!-- Sparkline -->
    <script src="~/AdminLTE-master/plugins/sparklines/sparkline.js"></script>
    <!-- JQVMap -->
    <script src="~/AdminLTE-master/plugins/jqvmap/jquery.vmap.min.js"></script>
    <script src="~/AdminLTE-master/plugins/jqvmap/maps/jquery.vmap.usa.js"></script>
    <!-- jQuery Knob Chart -->
    <script src="~/AdminLTE-master/plugins/jquery-knob/jquery.knob.min.js"></script>
    <!-- daterangepicker -->
    <script src="~/AdminLTE-master/plugins/moment/moment.min.js"></script>
    <script src="~/AdminLTE-master/plugins/daterangepicker/daterangepicker.js"></script>
    <!-- Tempusdominus Bootstrap 4 -->
    <script src="~/AdminLTE-master/plugins/tempusdominus-bootstrap-4/js/tempusdominus-boorap-4.min.js"></script>
    <!-- Summernote -->
    <script src="~/AdminLTE-master/plugins/summernote/summernote-bs4.min.js"></script>
    <!-- overlayScrollbars -->
    @*<script src="~/AdminLTE-master/plugins/overlayScrollbars/js/jquery.overlayScrollbars.min.js"></script>*@
    <!-- AdminLTE App -->
    <script src="~/AdminLTE-master/dist/js/adminlte.js"></script>
    <!-- AdminLTE for demo purposes -->
    @*<script src="~/AdminLTE-master/dist/js/demo.js"></script>*@
    <!-- AdminLTE dashboard demo (This is only for demo purposes) -->
    <script src="~/AdminLTE-master/dist/js/pages/dashboard.js"></script>
    @*<script src="~/JavaScript/Common/Count.js"></script>*@
    <script src="~/AdminLTE-master/plugins/toastr/toastr.min.js"></script>
    <script src="~/JavaScript/Common/LayoutMain.js?v=@DateTime.Now.Ticks"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
