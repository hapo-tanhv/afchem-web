@{
    ViewBag.Title = "SOLAR SCADA SYSTEM - REPORT";
    ViewBag.ButtonHome = "";
    ViewBag.ButtonOverview = "";
    ViewBag.ButtonAlarm = "";
    ViewBag.ButtonEvent = "";
    ViewBag.ButtonReport = "active";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/AdminLTE-master/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="~/Css/Overview.css?v=5" />
    <style>
        .filter-bar {
            background: #1e293b;
            border-radius: 0.5rem;
            padding: 0.9375rem 1.25rem;
            margin-bottom: 1.25rem;
            display: flex;
            flex-direction: column;
            gap: 0.9375rem;
            box-shadow: 0 0.25rem 0.375rem -0.0625rem rgba(0, 0, 0, 0.1), 0 0.125rem 0.25rem -0.0625rem rgba(0, 0, 0, 0.06);
            border: 0.0625rem solid rgba(255, 255, 255, 0.05);
        }
        .filter-inputs {
            display: flex;
            align-items: center;
            gap: 0.9375rem;
            flex-wrap: wrap;
            width: 100%;
        }
        .filter-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.625rem;
            width: 100%;
            border-top: 0.0625rem solid rgba(255, 255, 255, 0.05);
            padding-top: 0.75rem;
        }
        .filter-group {
            display: flex;
            flex-direction: column;
            align-items: unset !important;
            gap: 0.3125rem;
        }
        .filter-label {
            color: #94a3b8;
            font-weight: 500;
            font-size: 0.875rem;
        }
        .filter-input {
            background: rgba(15, 23, 42, 0.6);
            border: 0.0625rem solid rgba(59, 130, 246, 0.25);
            color: #00e5ff;
            padding: 0.375rem 0.75rem;
            border-radius: 0.25rem;
            font-size: 0.875rem;
            outline: none;
        }
        .filter-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.0625rem #3b82f6;
        }
        .btn-custom {
            padding: 0.375rem 1rem;
            border-radius: 0.25rem;
            font-weight: 500;
            font-size: 0.875rem;
            border: none;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-submit {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
            border: 0.0625rem solid rgba(59, 130, 246, 0.4);
        }
        .btn-submit:hover {
            background: rgba(59, 130, 246, 0.3);
        }
        .btn-export {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
            border: 0.0625rem solid rgba(16, 185, 129, 0.4);
        }
        .btn-export:hover {
            background: rgba(16, 185, 129, 0.4);
        }
        .dataTables_wrapper .dataTables_length, .dataTables_wrapper .dataTables_filter, 
        .dataTables_wrapper .dataTables_info, .dataTables_wrapper .dataTables_processing, 
        .dataTables_wrapper .dataTables_paginate, .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            color: #a9b7cb !important;
        }
        .dataTables_wrapper .dataTables_length select, .dataTables_wrapper .dataTables_filter input {
            background: rgba(15, 23, 42, 0.6);
            border: 0.0625rem solid rgba(59, 130, 246, 0.25);
            color: #00e5ff;
            border-radius: 0.25rem;
        }
        table.dataTable tbody tr {
            background-color: transparent !important;
        }
        table.dataTable tbody tr td {
            color: #e2e8f0 !important;
        }
        table.dataTable tbody tr.odd {
            background-color: rgba(255, 255, 255, 0.02) !important;
        }
        table.dataTable tbody tr:hover {
            background-color: rgba(59, 130, 246, 0.1) !important;
        }
        .batch-table th {
            font-size: 0.8125rem !important;
        }
        /* Autocomplete Premium Dark Theme */
        .ui-autocomplete {
            background: rgba(15, 23, 42, 0.95) !important;
            border: 0.0625rem solid rgba(59, 130, 246, 0.4) !important;
            border-radius: 0.375rem !important;
            color: #e2e8f0 !important;
            max-height: 15.625rem !important;
            overflow-y: auto !important;
            z-index: 2000 !important;
            box-shadow: 0 0.625rem 1.5625rem -0.3125rem rgba(0, 0, 0, 0.5), 0 0.5rem 0.625rem -0.375rem rgba(0, 0, 0, 0.5) !important;
            backdrop-filter: blur(0.75rem) !important;
            padding: 0.3125rem 0 !important;
        }
        .ui-menu-item {
            padding: 0 !important;
            list-style: none !important;
        }
        .ui-menu-item .ui-menu-item-wrapper {
            padding: 0.5rem 0.9375rem !important;
            color: #cbd5e1 !important;
            transition: all 0.2s ease !important;
            border: none !important;
            background: transparent !important;
            font-size: 0.8125rem !important;
            display: block !important;
        }
        .ui-menu-item .ui-menu-item-wrapper:hover,
        .ui-menu-item .ui-menu-item-wrapper.ui-state-active {
            background: rgba(59, 130, 246, 0.25) !important;
            color: #00e5ff !important;
            border: none !important;
            cursor: pointer !important;
        }
    </style>
}

<div class="overview-dashboard">
    <!-- REPORT PANEL -->
    <div class="history-panel" style="width: 100%;">
        <div class="panel-header" style="margin-bottom: 0.9375rem;">
            <h3>Báo Cáo Hoạt Động</h3>
        </div>
        
        <!-- FILTER BAR -->
        <div class="filter-bar">
            <div class="filter-inputs">
                <div class="filter-group">
                    <span class="filter-label">Từ ngày</span>
                    <input type="text" id="starttime" name="starttime" class="filter-input datepicker" value="@DateTime.Now.ToString("yyyy/MM/dd")">
                </div>
                <div class="filter-group">
                    <span class="filter-label">Đến ngày</span>
                    <input type="text" id="endtime" name="endtime" class="filter-input datepicker" value="@DateTime.Now.ToString("yyyy/MM/dd")">
                </div>
                <div class="filter-group" style="margin-left: 0.625rem;">
                    <span class="filter-label">Chọn batch</span>
                    <select id="batchId" class="filter-input" style="min-width: 7.5rem;">
                        <option value="0">-- Tất cả --</option>
                    </select>
                </div>
                <div class="filter-group" style="margin-left: 0.625rem;">
                    <span class="filter-label">Chọn mẻ (Run)</span>
                    <select id="runId" class="filter-input" style="min-width: 8.75rem;" disabled>
                        <option value="0">Không có mẻ con</option>
                    </select>
                </div>
                <div class="filter-group" style="margin-left: 0.625rem; position: relative;">
                    <span class="filter-label">Tìm nhanh mẻ</span>
                    <input type="text" id="runSearch" class="filter-input" placeholder="Nhập tên mẻ..." style="min-width: 9.375rem; font-size: 0.8125rem;">
                </div>
            </div>
            
            <div class="filter-actions">
                <button onclick="reloadTable()" class="btn-custom btn-submit"><i class="fas fa-search"></i> Tìm kiếm</button>
                @if (Session["Role"] != null && (int)Session["Role"] == (int)Hino.Getdata.Common.Role.Admin)
                {
                    <button onclick="ExportExcel()" class="btn-custom btn-export"><i class="fas fa-file-excel"></i> Export Excel</button>
                    <button onclick="ExportCSV()" class="btn-custom btn-export"><i class="fas fa-file-csv"></i> Export CSV</button>
                }
            </div>
        </div>
        <!-- CHART CARD -->
        <div class="card card-outline card-primary" id="reportChartCard" style="background: #1e293b; border-color: #3b82f6; margin-bottom: 1.25rem; box-shadow: 0 0.25rem 0.375rem -0.0625rem rgba(0, 0, 0, 0.1);">
            <div class="card-header" style="position: relative; border-bottom: 0.0625rem solid rgba(255, 255, 255, 0.05); display: flex; justify-content: space-between; align-items: center; padding: 0.75rem 1.25rem;">
                <h3 class="card-title" style="color: #e2e8f0; font-size: 1rem; font-weight: 600; margin: 0; display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-chart-line" style="color: #00e5ff;"></i> Biểu đồ nhiệt độ hoạt động
                </h3>
                <div class="card-tools" style="position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); margin: 0; display: flex; align-items: center;">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse" style="color: #94a3b8; background: transparent; border: none; padding: 0.25rem 0.5rem; outline: none; display: inline-flex; align-items: center; justify-content: center;"><i class="fas fa-minus"></i></button>
                </div>
            </div>
            <div class="card-body" style="padding: 1rem;">
                <div id="reportChartContainer" style="width: 100%; height: 350px; background: transparent;"></div>
            </div>
        </div>

        <div class="table-responsive" style="margin-top: 0.9375rem;">
            <table id="reportTable" class="batch-table" style="width:100%">
                <thead>
                    <tr>
                        <th>Ngày</th>
                        <th>Giờ</th>
                        <th>Quy trình</th>
                        <th>Công đoạn</th>
                        <th>T/g cấp liệu</th>
                        <th>T/g trộn 1</th>
                        <th>T/g xả đáy</th>
                        <th>T/g rung xả đáy</th>
                        <th>T/g hút xả đáy</th>
                        <th>T/g trộn 2</th>
                        <th>T/g xả hàng</th>
                        <th>T/g rung xả hàng</th>
                        <th>Tổng t/g trộn</th>
                        <th>Áp suất</th>
                        <th>Nhiệt độ MT</th>
                        <th>Độ ẩm MT</th>
                        <th>Nhiệt nắp bồn</th>
                        <th>Nhiệt giữa bồn</th>
                        <th>Nhiệt đáy bồn</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Highcharts CDN -->
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/series-label.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script src="https://code.highcharts.com/modules/export-data.js"></script>
    <script src="https://code.highcharts.com/modules/accessibility.js"></script>
    <script src="https://code.highcharts.com/highcharts-more.js"></script>
    <script src="https://code.highcharts.com/modules/solid-gauge.js"></script>
    <script src="https://code.highcharts.com/modules/no-data-to-display.js"></script>

    <script src="~/AdminLTE-master/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/AdminLTE-master/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        var reportDt;
        var isInitialLoad = true;

        $(document).ready(function () {
            // Init daterangepicker
            var dpLocale = {
                format: 'YYYY/MM/DD',
                daysOfWeek: ["CN", "T2", "T3", "T4", "T5", "T6", "T7"],
                monthNames: ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6", "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"],
            };

            $('#starttime').daterangepicker({
                singleDatePicker: true,
                autoApply: true,
                locale: dpLocale
            }).on('apply.daterangepicker', function (ev, picker) {
                var selectedDate = picker.startDate;
                var endDrp = $('#endtime').data('daterangepicker');
                if (endDrp) {
                    endDrp.minDate = selectedDate;
                    if (endDrp.startDate.isBefore(selectedDate)) {
                        endDrp.setStartDate(selectedDate);
                        endDrp.setEndDate(selectedDate);
                        $('#endtime').val(selectedDate.format('YYYY/MM/DD'));
                    }
                }
                setTimeout(function() {
                    loadBatchesRange();
                }, 50);
            });

            $('#endtime').daterangepicker({
                singleDatePicker: true,
                autoApply: true,
                locale: dpLocale
            }).on('apply.daterangepicker', function (ev, picker) {
                var selectedDate = picker.startDate;
                var startDrp = $('#starttime').data('daterangepicker');
                if (startDrp) {
                    startDrp.maxDate = selectedDate;
                    if (startDrp.startDate.isAfter(selectedDate)) {
                        startDrp.setStartDate(selectedDate);
                        startDrp.setEndDate(selectedDate);
                        $('#starttime').val(selectedDate.format('YYYY/MM/DD'));
                    }
                }
                setTimeout(function() {
                    loadBatchesRange();
                }, 50);
            });

            // Handle manual keyboard input focusout validation
            $('#starttime').on('focusout', function () {
                var startVal = $(this).val() || "";
                var endVal = $('#endtime').val() || "";
                var startM = moment(startVal, 'YYYY/MM/DD', true);
                var endM = moment(endVal, 'YYYY/MM/DD', true);
                
                if (startM.isValid() && endM.isValid()) {
                    if (startM.isAfter(endM)) {
                        $('#endtime').val(startVal);
                        var endDrp = $('#endtime').data('daterangepicker');
                        if (endDrp) {
                            endDrp.setStartDate(startM);
                            endDrp.setEndDate(startM);
                        }
                    }
                    var endDrp = $('#endtime').data('daterangepicker');
                    if (endDrp) {
                        endDrp.minDate = startM;
                    }
                    var startDrp = $(this).data('daterangepicker');
                    if (startDrp) {
                        startDrp.setStartDate(startM);
                        startDrp.setEndDate(startM);
                    }
                    loadBatchesRange();
                }
            });

            $('#endtime').on('focusout', function () {
                var startVal = $('#starttime').val() || "";
                var endVal = $(this).val() || "";
                var startM = moment(startVal, 'YYYY/MM/DD', true);
                var endM = moment(endVal, 'YYYY/MM/DD', true);
                
                if (startM.isValid() && endM.isValid()) {
                    if (startM.isAfter(endM)) {
                        $('#starttime').val(endVal);
                        var startDrp = $('#starttime').data('daterangepicker');
                        if (startDrp) {
                            startDrp.setStartDate(endM);
                            startDrp.setEndDate(endM);
                        }
                    }
                    var startDrp = $('#starttime').data('daterangepicker');
                    if (startDrp) {
                        startDrp.maxDate = endM;
                    }
                    var endDrp = $(this).data('daterangepicker');
                    if (endDrp) {
                        endDrp.setStartDate(endM);
                        endDrp.setEndDate(endM);
                    }
                    loadBatchesRange();
                }
            });

            // Bind cascading batchId changes
            $('#batchId').on('change', function () {
                $('#runSearch').val('');
                loadRuns($(this).val());
            });

            $('#runId').on('change', function () {
                $('#runSearch').val('');
            });

            // Init Autocomplete Search
            $("#runSearch").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/Overview/SearchRuns",
                        type: "GET",
                        data: { query: request.term },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    label: item.label + " (" + item.batch_name + ")",
                                    value: item.label,
                                    id: item.value,
                                    batch_id: item.batch_id,
                                    batch_name: item.batch_name,
                                    batch_start: item.batch_start,
                                    batch_end: item.batch_end
                                };
                            }));
                        }
                    });
                },
                minLength: 1,
                select: function (event, ui) {
                    var item = ui.item;
                    if (item) {
                        if (item.batch_start && item.batch_end) {
                            $('#starttime').val(item.batch_start);
                            $('#endtime').val(item.batch_end);

                            var startDrp = $('#starttime').data('daterangepicker');
                            if (startDrp) {
                                startDrp.setStartDate(item.batch_start);
                                startDrp.setEndDate(item.batch_start);
                            }
                            var endDrp = $('#endtime').data('daterangepicker');
                            if (endDrp) {
                                endDrp.setStartDate(item.batch_end);
                                endDrp.setEndDate(item.batch_end);
                            }
                        }

                        loadBatchesRange(function () {
                            $('#batchId').val(item.batch_id);
                            loadRuns(item.batch_id, function () {
                                $('#runId').val(item.id);
                                reloadTable();
                            });
                        });
                    }
                }
            });

            // Init DataTable with live data
            initDataTable('#reportTable');
        });

        function loadBatchesRange(callback) {
            var starttime = $('#starttime').val() || "";
            var endtime = $('#endtime').val() || "";
            var startFormatted = starttime.replace(/\//g, '-');
            var endFormatted = endtime.replace(/\//g, '-');

            $.ajax({
                url: '/Home/GetBatches',
                type: 'GET',
                data: { starttime: startFormatted, endtime: endFormatted },
                dataType: 'json',
                success: function (data) {
                    var select = $('#batchId');
                    if (select.length) {
                        select.empty();
                        select.append('<option value="0">-- Tất cả --</option>');
                        if (data && data.length) {
                            data.forEach(function (batch) {
                                var label = batch.name;
                                if (batch.status === 'Active') {
                                    label += ' (Active)';
                                } else if (batch.status === 'Completed') {
                                    label += ' (Completed)';
                                }
                                select.append('<option value="' + batch.id + '">' + label + '</option>');
                            });
                        }
                    }
                    loadRuns(select.val(), function () {
                        if (typeof callback === 'function') {
                            callback();
                        }
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi khi tải danh sách batches:", error);
                    loadRuns("0", function () {
                        if (typeof callback === 'function') {
                            callback();
                        }
                    });
                }
            });
        }

        function loadRuns(batchId, callback) {
            var select = $('#runId');
            if (batchId === "0" || batchId === "") {
                select.empty();
                select.append('<option value="0">-- Tất cả mẻ --</option>');
                select.prop('disabled', true);
                if (typeof callback === 'function') callback();
                return;
            }

            $.ajax({
                url: '/Overview/GetRuns',
                type: 'GET',
                data: { batch_id: batchId },
                dataType: 'json',
                success: function (data) {
                    select.empty();
                    if (data && data.length > 0) {
                        select.append('<option value="0">-- Tất cả mẻ --</option>');
                        data.forEach(function (item) {
                            var statusLabel = item.status === 'Active' ? ' (Active)' : '';
                            select.append('<option value="' + item.id + '">' + item.name + statusLabel + '</option>');
                        });
                        select.prop('disabled', false);
                    } else {
                        select.append('<option value="0">Không có mẻ con</option>');
                        select.prop('disabled', true);
                    }
                    if (typeof callback === 'function') {
                        callback();
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Failed to load runs:', error);
                    select.empty();
                    select.append('<option value="0">Lỗi tải dữ liệu</option>');
                    select.prop('disabled', true);
                    if (typeof callback === 'function') {
                        callback();
                    }
                }
            });
        }

        function initDataTable(selector) {
            reportDt = $(selector).DataTable({
                "processing": true,
                "serverSide": true,
                "searching": false,
                "ajax": {
                    "url": "/Home/GetReportData",
                    "type": "POST",
                    "data": function (d) {
                        d.starttime = $('#starttime').val() || "";
                        d.endtime = $('#endtime').val() || "";
                        d.batchId = $('#batchId').val() || "0";
                        d.runId = $('#runId').val() || "0";
                        d.isInitialLoad = isInitialLoad;
                    }
                },
                "columns": [
                    { "data": "Date" },
                    { "data": "Time" },
                    { "data": "QuyTrinh" },
                    { "data": "CongDoan" },
                    { "data": "TgCapLieu" },
                    { "data": "TgTron1" },
                    { "data": "TgXaDay" },
                    { "data": "TgRungXaDay" },
                    { "data": "TgHutXaDay" },
                    { "data": "TgTron2" },
                    { "data": "TgXaHang" },
                    { "data": "TgRungXaHang" },
                    { "data": "TongTgTron" },
                    { "data": "ApSuat" },
                    { "data": "NhietDoMT" },
                    { "data": "DoAmMT" },
                    { "data": "NhietNapBon" },
                    { "data": "NhietGiuaBon" },
                    { "data": "NhietDayBon" }
                ],
                "ordering": false,
                "scrollX": true,
                "pageLength": 10,
                "lengthMenu": [10, 25, 50, 100],
                "language": {
                    "search": "Tìm kiếm:",
                    "lengthMenu": "Hiển thị _MENU_ bản ghi",
                    "info": "Hiển thị _START_ đến _END_ của _TOTAL_ bản ghi",
                    "infoEmpty": "Hiển thị 0 đến 0 của 0 bản ghi",
                    "infoFiltered": "(lọc từ _MAX_ bản ghi)",
                    "paginate": {
                        "first": "Đầu",
                        "last": "Cuối",
                        "next": "Sau",
                        "previous": "Trước"
                    }
                }
            }).on('xhr.dt', function (e, settings, json, xhr) {
                if (isInitialLoad && json && json.resolvedBatchId > 0) {
                    var startVal = json.batchDateStart;
                    var endVal = json.batchDateEnd;
                    $('#starttime').val(startVal);
                    $('#endtime').val(endVal);

                    var drpStart = $('#starttime').data('daterangepicker');
                    if (drpStart) {
                        drpStart.setStartDate(startVal);
                        drpStart.setEndDate(startVal);
                    }
                    var drpEnd = $('#endtime').data('daterangepicker');
                    if (drpEnd) {
                        drpEnd.setStartDate(endVal);
                        drpEnd.setEndDate(endVal);
                    }

                    loadBatchesRange(function () {
                        $('#batchId').val(json.resolvedBatchId);
                        loadRuns(json.resolvedBatchId, function () {
                            if (json.resolvedRunId > 0) {
                                $('#runId').val(json.resolvedRunId);
                            }
                            loadChartData();
                        });
                    });
                    isInitialLoad = false;
                } else {
                    if (!isInitialLoad) {
                        loadChartData();
                    }
                }
            });
        }

        var reportChart;

        function loadChartData() {
            var starttime = $('#starttime').val() || "";
            var endtime = $('#endtime').val() || "";
            var batchId = $('#batchId').val() || "0";
            var runId = $('#runId').val() || "0";
            var searchValue = '';
            if (reportDt) {
                searchValue = reportDt.search() || '';
            }

            $.ajax({
                url: '/Home/GetReportChartData',
                type: 'POST',
                data: {
                    starttime: starttime,
                    endtime: endtime,
                    batchId: batchId,
                    runId: runId,
                    isInitialLoad: false,
                    searchValue: searchValue
                },
                dataType: 'json',
                success: function (data) {
                    renderChart(data);
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi khi tải dữ liệu biểu đồ:", error);
                }
            });
        }

        function renderChart(data) {
            var categories = [];
            var standardSeries = [];
            var tempMT = [];
            var tempNap = [];
            var tempGiua = [];
            var tempDay = [];

            if (data && data.length > 0) {
                data.forEach(function (item) {
                    categories.push(item.Time);
                    standardSeries.push(40.0);
                    tempMT.push(item.NhietDoMT);
                    tempNap.push(item.NhietNapBon);
                    tempGiua.push(item.NhietGiuaBon);
                    tempDay.push(item.NhietDayBon);
                });
            }

            if (!reportChart) {
                reportChart = Highcharts.chart('reportChartContainer', {
                    chart: {
                        type: 'spline',
                        backgroundColor: 'transparent',
                        zoomType: 'x'
                    },
                    title: {
                        text: 'Xu hướng nhiệt độ',
                        style: {
                            color: '#ffffff',
                            fontSize: '16px'
                        }
                    },
                    xAxis: {
                        categories: categories,
                        labels: {
                            style: { color: '#94a3b8' },
                            formatter: function() {
                                var val = this.value;
                                if (val && val.length > 10) {
                                    return val.substring(11);
                                }
                                return val;
                            }
                        },
                        lineColor: '#475569',
                        tickColor: '#475569'
                    },
                    yAxis: {
                        title: {
                            text: 'Nhiệt độ (°C)',
                            style: { color: '#e2e8f0' }
                        },
                        labels: {
                            style: { color: '#94a3b8' },
                            format: '{value}°C'
                        },
                        gridLineColor: 'rgba(255,255,255,0.05)'
                    },
                    tooltip: {
                        shared: true,
                        crosshairs: true,
                        backgroundColor: 'rgba(15, 23, 42, 0.95)',
                        borderColor: '#3b82f6',
                        borderWidth: 1,
                        style: { color: '#ffffff' },
                        valueSuffix: ' °C'
                    },
                    legend: {
                        itemStyle: { color: '#94a3b8' },
                        itemHoverStyle: { color: '#ffffff' }
                    },
                    plotOptions: {
                        spline: {
                            marker: {
                                enabled: false,
                                radius: 3
                            },
                            lineWidth: 2
                        }
                    },
                    series: [{
                        name: 'Tiêu chuẩn nhiệt độ (40°C)',
                        data: standardSeries,
                        color: '#ef4444',
                        dashStyle: 'ShortDash',
                        marker: { enabled: false }
                    }, {
                        name: 'Nhiệt độ môi trường',
                        data: tempMT,
                        color: '#10b981'
                    }, {
                        name: 'Nhiệt độ nắp bồn',
                        data: tempNap,
                        color: '#3b82f6'
                    }, {
                        name: 'Nhiệt độ giữa bồn',
                        data: tempGiua,
                        color: '#8b5cf6'
                    }, {
                        name: 'Nhiệt độ đáy bồn',
                        data: tempDay,
                        color: '#ec4899'
                    }],
                    credits: { enabled: false },
                    lang: {
                        noData: "Không có dữ liệu hiển thị"
                    },
                    noData: {
                        style: {
                            fontWeight: 'bold',
                            fontSize: '15px',
                            color: '#94a3b8'
                        }
                    }
                });
            } else {
                reportChart.xAxis[0].setCategories(categories, false);
                reportChart.series[0].setData(standardSeries, false);
                reportChart.series[1].setData(tempMT, false);
                reportChart.series[2].setData(tempNap, false);
                reportChart.series[3].setData(tempGiua, false);
                reportChart.series[4].setData(tempDay, false);
                reportChart.redraw();
            }
        }

        function reloadTable() {
            reportDt.ajax.reload();
        }

        function ExportExcel() {
            var starttime = $('#starttime').val() + " 00:00:00";
            var endtime = $('#endtime').val() + " 23:59:59";
            var batchId = $('#batchId').val();
            var runId = $('#runId').val() || "0";
            var searchValue = reportDt.search();

            var url = "/Home/ExportReportExcel?starttime=" + starttime + "&endtime=" + endtime + "&batchId=" + batchId + "&runId=" + runId + "&searchValue=" + searchValue;
            window.location.href = url;
        }

        function ExportCSV() {
            var starttime = $('#starttime').val() + " 00:00:00";
            var endtime = $('#endtime').val() + " 23:59:59";
            var batchId = $('#batchId').val();
            var runId = $('#runId').val() || "0";
            var searchValue = reportDt.search();

            var url = "/Home/ExportReportCSV?starttime=" + starttime + "&endtime=" + endtime + "&batchId=" + batchId + "&runId=" + runId + "&searchValue=" + searchValue;
            window.location.href = url;
        }
    </script>
}
