@section Styles {
    <link rel="stylesheet" href="~/Css/Overview.css?v=5" />
    <style>
        /* Glassmorphism Run Selector Tabs */
        .run-selector-tabs {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            background: rgba(15, 23, 42, 0.4);
            padding: 0.25rem;
            border-radius: 0.5rem;
            border: 0.0625rem solid rgba(255, 255, 255, 0.05);
        }
        .run-tab {
            padding: 0.375rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.75rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            background: rgba(255, 255, 255, 0.02);
            border: 0.0625rem solid rgba(255, 255, 255, 0.06);
            color: #94a3b8;
            display: flex;
            align-items: center;
            gap: 0.375rem;
        }
        .run-tab:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.15);
            color: #fff;
        }
        .run-tab.selected {
            color: #fff;
            box-shadow: 0 0 0.625rem rgba(59, 130, 246, 0.2);
        }
        .run-tab.selected.Active {
            background: linear-gradient(135deg, #00c6ff, #0072ff);
            border-color: #00c6ff;
        }
        .run-tab.selected.Completed {
            background: linear-gradient(135deg, #10b981, #059669);
            border-color: #10b981;
        }
        .run-tab.selected.Pending {
            background: linear-gradient(135deg, #4b5563, #374151);
            border-color: #4b5563;
        }
        .run-tab-badge {
            padding: 0.125rem 0.3125rem;
            border-radius: 0.25rem;
            font-size: 0.5625rem;
            font-weight: bold;
            text-transform: uppercase;
        }
        .run-tab.Active .run-tab-badge { background: rgba(0, 229, 255, 0.2); color: #00e5ff; }
        .run-tab.Completed .run-tab-badge { background: rgba(16, 185, 129, 0.2); color: #10b981; }
        .run-tab.Pending .run-tab-badge { background: rgba(148, 163, 184, 0.2); color: #94a3b8; }
        
        /* Tank diagram overlay styling for historic mode */
        .tank-diagram-container.historic-mode {
            position: relative;
        }
        .tank-diagram-container.historic-mode::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.35);
            pointer-events: none;
            z-index: 5;
            border-radius: 0.75rem;
            transition: all 0.3s;
        }
        .historic-overlay-badge {
            position: absolute;
            top: 0.9375rem;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #f59e0b, #d97706);
            color: #fff;
            padding: 0.375rem 1rem;
            border-radius: 1.25rem;
            font-size: 0.75rem;
            font-weight: bold;
            box-shadow: 0 0.25rem 0.9375rem rgba(245, 158, 11, 0.4);
            z-index: 10;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 0.0625rem solid rgba(255, 255, 255, 0.15);
            letter-spacing: 0.0312rem;
        }
    </style>
}
