</div>
<script>
    const mockBatchData = [
        {
            process: "Cấp liệu", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        },
        {
            process: "Trộn 1", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        },
        {
            process: "Xả đáy", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        },
        {
            process: "Rung xả đáy", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        },
        {
            process: "Hút xả đáy", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        },
        {
            process: "Trộn 2", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        },
        {
            process: "Xả hàng", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        },
        {
            process: "Rung xả hàng", standard: "0s", start: "-", end: "-", duration: "-",
            tempTop: "-", tempMid: "-", tempBot: "-",
            status: "pending", statusText: "Chờ chạy", alerts: []
        }
    ];
    function renderBatchTable(data) {
        const tbody = document.getElementById('batchTableBody');
        if (!tbody) return;
        let html = '';
        data.forEach((step, index) => {
            const rowActive = step.status === 'in-progress' ? 'row-active' : '';
            
            // Get standard time directly from database
            let standardVal = step.standard;
            
            const durationColor = (step.duration && step.duration !== '-' && parseInt(step.duration) > parseInt(standardVal)) ? 'text-warning' : '';
            const tempColor = step.status === 'pending' ? 'text-cyan' : '';
            html += `<tr class="${rowActive}">
    <td class="td-process">${step.process}</td>
    <td class="td-standard">${standardVal}</td>
    <td class="td-start">${step.start}</td>
    <td class="td-end">${step.end}</td>
    <td class="td-duration ${durationColor}">${step.duration}</td>
    <td class="td-temp ${tempColor}">${step.tempTop}</td>
    <td class="td-temp ${tempColor}">${step.tempMid}</td>
    <td class="td-temp ${tempColor}">${step.tempBot}</td>
    <td class="td-status">
    <span class="status-badge ${step.status}">${step.statusText}</span>
    </td>`;
            if (step.alerts && step.alerts.length > 0) {
                const alarmCount = step.alerts.filter(a => a.type === 'ALARM' || a.type === 'HIGH').length;
                const warningCount = step.alerts.filter(a => a.type === 'WARNING' || a.type === 'AVERAGE').length;
                const lowCount = step.alerts.filter(a => a.type === 'LOW').length;
                const mainType = alarmCount > 0 ? 'HIGH' : (warningCount > 0 ? 'WARNING' : (lowCount > 0 ? 'LOW' : 'INFO'));
                
                let iconColor = '#ef4444'; // Red for HIGH / ALARM
                let blinkClass = 'blink-alarm';
                let bgTint = 'rgba(239, 68, 68, 0.08)';
                let borderTint = 'rgba(239, 68, 68, 0.15)';
                
                if (mainType === 'WARNING') {
                    iconColor = '#f59e0b'; // Orange for WARNING / AVERAGE
                    blinkClass = '';
                    bgTint = 'rgba(245, 158, 11, 0.08)';
                    borderTint = 'rgba(245, 158, 11, 0.15)';
                } else if (mainType === 'LOW') {
                    iconColor = '#eab308'; // Yellow for LOW
                    blinkClass = '';
                    bgTint = 'rgba(234, 179, 8, 0.08)';
                    borderTint = 'rgba(234, 179, 8, 0.15)';
                } else if (mainType === 'INFO') {
                    iconColor = '#ffffff'; // White for INFO
                    blinkClass = '';
                    bgTint = 'rgba(255, 255, 255, 0.08)';
                    borderTint = 'rgba(255, 255, 255, 0.15)';
                }
                
                html += `<td class="td-alerts text-warning" colspan="3" style="padding: 0; vertical-align: middle;">
    <div class="alarm-summary" onclick="toggleAlarmCollapse(this)" style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; cursor: pointer; padding: 0.75rem 0.625rem; height: 100%;">
    <div class="alarm-icon warning ${blinkClass}" style="color: ${iconColor}; font-size: 1.25rem;">
    <i class="fas fa-exclamation-triangle"></i>
    </div>
    <span style="font-weight: bold; font-size: 0.875rem; color: ${iconColor}">${step.alerts.length}</span>
    <i class="fas fa-chevron-up toggle-icon" style="font-size: 0.75rem; color: #94a3b8; margin-left: 0.25rem; transition: transform 0.2s;"></i>
    </div>
    </td></tr>`;
                html += `<tr class="alarm-detail-row" style="display: none;">
    <td colspan="12" style="padding: 0;">
    <div class="alarm-collapse-content" style="background: ${bgTint}; padding: 0.9375rem 1.25rem; border-top: 0.0625rem solid ${borderTint}; text-align: left; margin: 0; box-shadow: inset 0 0.125rem 0.625rem rgba(0,0,0,0.2);">`;
                step.alerts.forEach(alert => {
                    const typeUpper = (alert.type || '').toUpperCase();
                    let color = '#ffffff'; // Default to White for INFO
                    let badgeBg = 'rgba(255, 255, 255, 0.08)';
                    let badgeBorder = 'rgba(255, 255, 255, 0.15)';
                    
                    if (typeUpper === 'ALARM' || typeUpper === 'HIGH') {
                        color = '#ef4444'; // Red
                        badgeBg = 'rgba(239, 68, 68, 0.1)';
                        badgeBorder = 'rgba(239, 68, 68, 0.2)';
                    } else if (typeUpper === 'WARNING' || typeUpper === 'AVERAGE') {
                        color = '#f59e0b'; // Orange
                        badgeBg = 'rgba(245, 158, 11, 0.1)';
                        badgeBorder = 'rgba(245, 158, 11, 0.2)';
                    } else if (typeUpper === 'LOW') {
                        color = '#eab308'; // Yellow
                        badgeBg = 'rgba(234, 179, 8, 0.1)';
                        badgeBorder = 'rgba(234, 179, 8, 0.2)';
                    }
                    html += `<div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 0.625rem;">
    <div style="display: flex; gap: 1.25rem;">
    <div style="color: ${color}; font-size: 0.625rem; margin-top: 0.25rem;"><i class="fas fa-circle"></i></div>
    <div style="color: ${color}; font-size: 0.875rem; min-width: 5rem;">${alert.time}</div>
    <div style="color: ${color}; font-size: 0.875rem;">${alert.title}</div>
    <div style="color: #94a3b8; font-size: 0.8125rem;">${alert.message}</div>
    </div>
    <div style="background: ${badgeBg}; color: ${color}; border: 0.0625rem solid ${badgeBorder}; padding: 0.3125rem 0.75rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: 700; height: fit-content;">${alert.type}</div>
    </div>`;
                });
                html += `</div></td></tr>`;
            } else {
                html += `<td class="td-alerts" colspan="3">-</td></tr>`;
            }
        });
        tbody.innerHTML = html;
    }
    function toggleAlarmCollapse(element) {
        const currentTr = element.closest('tr');
        const detailRow = currentTr.nextElementSibling;
        const icon = element.querySelector('.toggle-icon');
        if (detailRow && detailRow.classList.contains('alarm-detail-row')) {
            if (detailRow.style.display === 'none' || detailRow.style.display === '') {
                detailRow.style.display = 'table-row';
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            } else {
                detailRow.style.display = 'none';
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            }
        }
    }
    const mockGlobalAlarms = [
        { time: "08:16:33", type: "WARNING", title: "Vượt quá thời gian cài đặt", message: "Giá trị: 840s (ngưỡng: 720s)" },
        { time: "08:45:11", type: "ALARM", title: "Nhiệt độ bồn trộn trên vượt ngưỡng cảnh báo", message: "Giá trị: 85.2 °C (ngưỡng: 84 °C)" },
        { time: "08:47:28", type: "ALARM", title: "Nhiệt độ bồn trộn giữa vượt ngưỡng cảnh báo", message: "Giá trị: 86.2 °C (ngưỡng: 85 °C)" },
        { time: "09:35:12", type: "WARNING", title: "Áp suất đường ống cao hơn ngưỡng cảnh báo", message: "Giá trị: 0.28 bar (ngưỡng: 0.25 bar)" },
        { time: "09:42:45", type: "WARNING", title: "Áp suất đường ống cao hơn ngưỡng cảnh báo", message: "Giá trị: 0.29 bar (ngưỡng: 0.25 bar)" }
    ];
    function renderAlarmList(data) {
        const container = document.getElementById('alarmListContainer');
        if (!container) return;
        let html = '';
        // Always display at most 5 items
        data.slice(0, 5).forEach(alarm => {
            const typeUpper = (alarm.type || '').toUpperCase();
            let color = '#ffffff'; // Default to White (INFO)
            let badgeBg = 'rgba(255, 255, 255, 0.08)';
            let badgeBorder = 'rgba(255, 255, 255, 0.15)';
            let iconClass = 'info';
            
            if (typeUpper === 'ALARM' || typeUpper === 'HIGH') {
                color = '#ef4444'; // Red
                badgeBg = 'rgba(239, 68, 68, 0.1)';
                badgeBorder = 'rgba(239, 68, 68, 0.2)';
                iconClass = 'alarm';
            } else if (typeUpper === 'WARNING' || typeUpper === 'AVERAGE') {
                color = '#f59e0b'; // Orange
                badgeBg = 'rgba(245, 158, 11, 0.1)';
                badgeBorder = 'rgba(245, 158, 11, 0.2)';
                iconClass = 'warning';
            } else if (typeUpper === 'LOW') {
                color = '#eab308'; // Yellow
                badgeBg = 'rgba(234, 179, 8, 0.1)';
                badgeBorder = 'rgba(234, 179, 8, 0.2)';
                iconClass = 'warning';
            }
            html += `<div class="alarm-item" style="display: flex; align-items: flex-start; gap: 0.625rem; padding-bottom: 0.3125rem; border-bottom: 0.0625rem solid rgba(255,255,255,0.05); min-width: 0;">
    <div class="alarm-icon ${iconClass}" style="color: ${color}; font-size: 1.125rem; padding-top: 0.375rem; flex-shrink: 0;">
    <i class="fas fa-exclamation-triangle"></i>
    </div>
    <div class="alarm-content" style="flex: 1; min-width: 0;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.25rem; gap: 0.3125rem; min-width: 0;">
    <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0; flex: 1;">
    <span style="color: #94a3b8; font-size: 0.75rem; flex-shrink: 0;">${alarm.time}</span>
    <span style="color: #fff; font-weight: 600; font-size: 0.75rem; max-width: 8.125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: inline-block;" title="${alarm.title}">${alarm.title}</span>
    </div>
    <span class="alarm-badge ${iconClass}" style="background: ${badgeBg}; color: ${color}; border: 0.0625rem solid ${badgeBorder}; padding: 0.25rem 0.625rem; border-radius: 0.25rem; font-size: 0.6875rem; font-weight: 700; width: 4.5rem; text-align: center; flex-shrink: 0;">${alarm.type}</span>
    </div>
    <div style="color: #94a3b8; font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${alarm.message}">${alarm.message}</div>
    </div>
    </div>`;
        });
        container.innerHTML = html;
    }
    function renderBOMTable(bom) {
        const container = document.getElementById('bomTablesContainer');
        if (!container) return;
        if (!bom || bom.length === 0) {
            container.innerHTML = `
                <div class="bom-panel">
                    <div class="panel-header">
                        <span class="header-accent" style="background: #3b82f6;"></span>
                        <h3>BOM sản xuất</h3>
                    </div>
                    <div style="color: #94a3b8; padding: 1.25rem; text-align: center; background: rgba(15, 23, 42, 0.45); border: 0.0625rem solid rgba(255, 255, 255, 0.05); border-radius: 0.5rem;">Không có dữ liệu BOM</div>
                </div>`;
            return;
        }

        // Group BOM by run_number
        const groups = {};
        bom.forEach(item => {
            const runNum = item.run_number || 1;
            if (!groups[runNum]) {
                groups[runNum] = [];
            }
            groups[runNum].push(item);
        });

        // Sort run numbers ascending
        const runNumbers = Object.keys(groups).sort((a, b) => Number(a) - Number(b));

        let html = '';
        runNumbers.forEach(runNum => {
            const items = groups[runNum];
            html += `
            <div class="bom-panel">
                <div class="panel-header" style="border-bottom: 0.0625rem solid rgba(255, 255, 255, 0.05); padding-bottom: 0.625rem;">
                    <span class="header-accent" style="background: #10b981;"></span>
                    <h3>BOM sản xuất - Mẻ ${runNum}</h3>
                </div>
                <div class="table-responsive">
                    <table class="bom-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th class="th-code">Mã hàng</th>
                                <th class="th-name">Tên nguyên vật liệu</th>
                                <th class="th-ratio">Tổng xuất</th>
                                <th class="th-unit">Đơn vị tính</th>
                                <th class="th-lot">Lot/No</th>
                            </tr>
                        </thead>
                        <tbody>`;
            items.forEach(item => {
                html += `
                            <tr>
                                <td class="td-code">${item.code || '-'}</td>
                                <td class="td-name">${item.material_code || '-'}</td>
                                <td class="td-ratio">${item.quantity !== null && item.quantity !== undefined ? item.quantity : '-'}</td>
                                <td class="td-unit">${item.unit || '-'}</td>
                                <td class="td-lot">${item.batch_no || '-'}</td>
                            </tr>`;
            });
            html += `
                        </tbody>
                    </table>
                </div>
            </div>`;
        });
        container.innerHTML = html;
    }
</script>
