<!-- Main content -->
<div class="overview-dashboard">
    <!-- BANNER CẢNH BÁO MẺ CHƯA CHẠY XUYÊN NGÀY -->
    <div id="pendingRunBanner" class="pending-run-banner" style="display: none; background: rgba(245, 158, 11, 0.15); border: 0.0625rem solid rgba(245, 158, 11, 0.3); border-radius: 0.75rem; padding: 0.9375rem 1.25rem; margin-bottom: 1.25rem; color: #f59e0b; align-items: center; gap: 0.75rem; font-weight: bold; font-size: 0.875rem; box-shadow: 0 0.25rem 0.9375rem rgba(245, 158, 11, 0.1);">
        <i class="fas fa-exclamation-triangle" style="font-size: 1.125rem;"></i>
        <span id="pendingRunBannerText"></span>
    </div>

    <!-- BẢNG ĐIỀU KHIỂN LỰA CHỌN BATCH CHẠY -->
    <div class="batch-selection-panel history-panel" id="batchSelectionPanel" style="margin-bottom: 1.25rem;">
        <div class="panel-header" style="border-bottom: 0.0625rem solid rgba(255, 255, 255, 0.05); padding-bottom: 0.625rem; margin-bottom: 0.9375rem; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center;">
                <span class="header-accent" style="background: #00e5ff;"></span>
                <h3 style="margin-bottom: 0;">Lựa chọn Batch chạy linh hoạt</h3>
            </div>
            <div id="selectionProductDisplay" style="font-size: 1rem; font-weight: bold; color: #00e5ff; text-transform: uppercase">
                Sản phẩm: <span id="selectionProductName" style="color: #fff;">-</span>
            </div>
            <span class="badge-active-status" id="activeStatusBadge" style="font-size: 0.6875rem; padding: 0.25rem 0.625rem; border-radius: 0.25rem; font-weight: bold; display: none;"></span>
        </div>
        <div class="batch-selection-content" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.25rem;">
            <!-- Bên trái: Thống kê số lượng mẻ/batch chờ -->
            <div class="standby-stats-container" style="display: flex; gap: 1.25rem; flex: 1; min-width: 18.75rem;">
                <div class="standby-stat-card" style="background: rgba(15, 23, 42, 0.4); border: 0.0625rem solid rgba(255, 255, 255, 0.05); border-radius: 0.5rem; padding: 0.75rem 1.25rem; display: flex; align-items: center; gap: 0.9375rem; flex: 1;">
                    <div style="font-size: 1.5rem; color: #00e5ff;"><i class="fas fa-layer-group"></i></div>
                    <div>
                        <div style="font-size: 0.6875rem; color: #94a3b8; text-transform: uppercase; font-weight: 600;">Batch chờ (Standby)</div>
                        <div id="standbyBatchesCount" style="font-size: 1.375rem; color: #fff; font-weight: bold; line-height: 1;">0</div>
                    </div>
                </div>
                <div class="standby-stat-card" style="background: rgba(15, 23, 42, 0.4); border: 0.0625rem solid rgba(255, 255, 255, 0.05); border-radius: 0.5rem; padding: 0.75rem 1.25rem; display: flex; align-items: center; gap: 0.9375rem; flex: 1;">
                    <div style="font-size: 1.5rem; color: #10b981;"><i class="fas fa-tasks"></i></div>
                    <div>
                        <div style="font-size: 0.6875rem; color: #94a3b8; text-transform: uppercase; font-weight: 600;">Mẻ chờ (Standby)</div>
                        <div id="standbyRunsCount" style="font-size: 1.375rem; color: #fff; font-weight: bold; line-height: 1;">0</div>
                    </div>
                </div>
            </div>

            <!-- Bên phải: Hộp chọn dropdown và nút Bắt đầu mẻ -->
            <div class="selection-controls-container" style="display: flex; gap: 0.9375rem; align-items: center; flex-wrap: wrap; min-width: 28.125rem; justify-content: flex-end;">
                <div class="control-group" style="display: flex; flex-direction: column; gap: 0.25rem;">
                    <label style="font-size: 0.6875rem; color: #94a3b8; font-weight: 600; text-transform: uppercase;">Chọn Lệnh SX (Batch)</label>
                    <select id="batchSelect" class="dark-input" style="width: 18.75rem; height: 2.25rem; padding: 0.375rem 0.75rem; background: #0a0a0a; border: 0.0625rem solid #334155; border-radius: 0.375rem; color: #fff; font-weight: bold;">
                        <option value="">-- Chọn Batch --</option>
                    </select>
                </div>
                <div class="control-group" style="display: flex; flex-direction: column; gap: 0.25rem;">
                    <label style="font-size: 0.6875rem; color: #94a3b8; font-weight: 600; text-transform: uppercase;">Chọn Mẻ (Run)</label>
                    <select id="runSelect" class="dark-input" style="width: 21.875rem; height: 2.25rem; padding: 0.375rem 0.75rem; background: #0a0a0a; border: 0.0625rem solid #334155; border-radius: 0.375rem; color: #fff; font-weight: bold;">
                        <option value="">-- Chọn Mẻ --</option>
                    </select>
                </div>
                <div class="control-group" style="display: flex; flex-direction: column; gap: 0.25rem; margin-top: 1.75rem;" id="startButtonWrapper">
                    <button id="btnStartBatch" class="btn-scada btn-excel" style="height: 2.25rem; margin-left: 0; padding: 0 1.25rem; display: flex; align-items: center; gap: 0.5rem; border-radius: 0.375rem; transition: all 0.3s;" disabled>
                        <i class="fas fa-play"></i> Bắt đầu ngay
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TRẠNG THÁI QUY TRÌNH -->
    <div class="process-status-panel">
        <div class="panel-header">
            <h3>Trạng thái quy trình</h3>
        </div>
        <div class="process-timeline-container">
            <ul class="process-steps" id="processTimeline">
                <li class="step" data-step="1">
                    <div class="step-icon"><i class="fas fa-check"></i></div>
                    <div class="step-label">1</div>
                    <div class="step-name">Cấp liệu</div>
                </li>
                <li class="step" data-step="2">
                    <div class="step-icon"><i class="fas fa-check"></i></div>
                    <div class="step-label">2</div>
                    <div class="step-name">Trộn 1</div>
                </li>
                <li class="step" data-step="3">
                    <div class="step-icon"><i class="fas fa-check"></i></div>
                    <div class="step-label">3</div>
                    <div class="step-name">Xả đáy</div>
                </li>
                <li class="step" data-step="4">
                    <div class="step-icon"><i class="fas fa-check"></i></div>
                    <div class="step-label">4</div>
                    <div class="step-name">Rung xả đáy</div>
                </li>
                <li class="step" data-step="5">
                    <div class="step-icon"><i class="fas fa-check"></i></div>
                    <div class="step-label">5</div>
                    <div class="step-name">Hút xả đáy</div>
                </li>
                <li class="step" data-step="6">
                    <div class="step-icon"><i class="fas fa-check"></i></div>
                    <div class="step-label">6</div>
                    <div class="step-name">Trộn 2</div>
                </li>
                <li class="step" data-step="7">
                    <div class="step-icon"><i class="fas fa-check"></i></div>
                    <div class="step-label">7</div>
                    <div class="step-name">Xả hàng</div>
                </li>
                <li class="step" data-step="8">
                    <div class="step-icon"></div>
                    <div class="step-label">8</div>
                    <div class="step-name">Rung xả hàng</div>
                </li>
            </ul>
            <div class="step-stats">
                <div class="stat-box">
                    <div class="stat-title">Bước hiện tại</div>
                    <div class="stat-val text-cyan" id="statCurrentStep">- / -</div>
                </div>
                <div class="stat-box">
                    <div class="stat-title">Thời gian chuẩn</div>
                    <div class="stat-val"><span id="statStandardTime">1800</span> <small>s</small></div>
                </div>
                <div class="stat-box">
                    <div class="stat-title">Thời gian đã chạy</div>
                    <div class="stat-val text-cyan"><span id="statElapsedTime">0</span> <small>s</small></div>
                </div>
                <div class="stat-box">
                    <div class="stat-title">Thời gian còn lại</div>
                    <div class="stat-val text-cyan"><span id="statRemainingTime">1800</span> <small>s</small></div>
                </div>
                <div class="stat-box">
                    <div class="stat-title">Tiến độ bước</div>
                    <div class="stat-val text-cyan" id="statProgressPercent">0%</div>
                    <div class="progress-bar-small">
                        <div class="progress-fill" id="statProgressFill" style="width: 0%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- MAIN CONTENT GRID -->
    <div class="overview-main-content">
        <!-- CENTER: SƠ ĐỒ THIẾT BỊ -->
        <div class="center-panel">
            <div class="panel-header">
                <h3>SƠ ĐỒ BỒN TRỘN</h3>
            </div>
            <div class="tank-diagram-container">
                <!-- Left Column -->
                <div class="tank-side-col left-col">
                    <div class="param-card-side">
                        <div class="param-card-icon icon-blue"><i class="fas fa-stopwatch"></i></div>
                        <div class="param-card-info">
                            <div class="param-card-title">Thời gian cấp liệu</div>
                            <div class="param-card-value"><span id="feedingTime">1426</span> <small>s</small></div>
                            <div class="param-card-std">Tiêu chuẩn: <span id="feedingTimeStandard">1426 <small>s</small></span></div>
                        </div>
                    </div>
                    <div class="param-card-side">
                        <div class="param-card-icon icon-cyan"><i class="fas fa-stopwatch"></i></div>
                        <div class="param-card-info">
                            <div class="param-card-title">Thời gian trộn 1</div>
                            <div class="param-card-value"><span id="mix1Time">885</span> <small>s</small></div>
                            <div class="param-card-std">Tiêu chuẩn: <span id="mix1TimeStandard">885 <small>s</small></span></div>
                        </div>
                    </div>
                    <div class="param-card-side">
                        <div class="param-card-icon icon-orange"><i class="fas fa-stopwatch"></i></div>
                        <div class="param-card-info">
                            <div class="param-card-title">Thời gian xả đáy</div>
                            <div class="param-card-value">
                                <span id="bottomDischargeTime">16</span> <small>s</small>
                            </div>
                            <div class="param-card-std">Tiêu chuẩn: <span id="bottomDischargeTimeStandard">496 <small>s</small></span></div>
                        </div>
                    </div>
                    <div class="param-card-side">
                        <div class="param-card-icon icon-purple"><i class="fas fa-stopwatch"></i></div>
                        <div class="param-card-info">
                            <div class="param-card-title">Thời gian rung xả đáy</div>
                            <div class="param-card-value">
                                <span id="bottomDischargeVibrationTime">16</span>
                                <small>s</small>
                            </div>
                            <div class="param-card-std">Tiêu chuẩn: <span id="bottomDischargeVibrationTimeStandard">16 <small>s</small></span></div>
                        </div>
                    </div>
                    <div class="param-card-side">
                        <div class="param-card-icon icon-purple"><i class="fas fa-tachometer-alt"></i></div>
                        <div class="param-card-info">
                            <div class="param-card-title">Áp suất đường ống</div>
                            <div class="param-card-value">
                                <span id="TankDiagramPressure">3.0</span> <small>bar</small>
                            </div>
                            <div class="param-card-std">Tiêu chuẩn: <span id="TankDiagramPressureStandard">3.0</span> bar</div>
                        </div>
                    </div>
                </div>
                <!-- Center Tank -->
                <div class="tank-center-wrapper">
                    <div class="tank-image-wrapper" style="position: relative; display: inline-block; max-height: 40.625rem; max-width: 100%;">
                        <img src="~/Image/sodobontron2.jpeg" alt="Sơ đồ bồn trộn" class="tank-img" style="display: block; max-height: 40.625rem; max-width: 100%;" />
                        <!-- Dynamic SVG Flow Layer -->
                        <svg viewBox="0 0 1000 1000" class="svg-flow-layer" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2;">
                            <!-- SVG Path Definitions -->
                            <path id="feedingPath" d="M 109 880 L 109 172 L 293 172 L 293 236 L 310 236" fill="none" stroke="none" />
                            <path id="dischargePath" d="M 500 780 L 615 832 L 931 832 L 931 920 L 945 920" fill="none" stroke="none" />
                            
                            <!-- Group 1: Feeding Flow (Cyan) -->
                            <g id="svgFlowFeeding" class="svg-flow-group">
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" begin="0.75s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" begin="1.5s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" begin="2.25s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" begin="3s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" begin="3.75s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" begin="4.5s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="6s" begin="5.25s" repeatCount="indefinite" rotate="auto"><mpath href="#feedingPath" /></animateMotion></path></g>
                            </g>

                            <!-- Group 2: Mixing Flow (Convection & Vortex Waves) -->
                            <g id="svgFlowMixing" class="svg-flow-group">
                                <!-- Horizontal Flat Vortex Swirls (Xoáy tròn dẹt) -->
                                <path class="vortex-wave top-wave" fill="none" d="M 500 480 A 140 25 0 1 0 499.9 480 Z" />
                                <path class="vortex-wave mid-wave" fill="none" d="M 500 610 A 100 20 0 1 0 499.9 610 Z" />
                                <path class="vortex-wave bot-wave" fill="none" d="M 500 740 A 60 15 0 1 0 499.9 740 Z" />
                            </g>

                            <!-- Group 3: Discharge Flow (Cyan) -->
                            <g id="svgFlowDischarge" class="svg-flow-group">
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="4s" repeatCount="indefinite" rotate="auto"><mpath href="#dischargePath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="4s" begin="1s" repeatCount="indefinite" rotate="auto"><mpath href="#dischargePath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="4s" begin="2s" repeatCount="indefinite" rotate="auto"><mpath href="#dischargePath" /></animateMotion></path></g>
                                <g><path d="M -11 -8 L 7 0 L -11 8 Z" fill="#00e5ff"><animateMotion dur="4s" begin="3s" repeatCount="indefinite" rotate="auto"><mpath href="#dischargePath" /></animateMotion></path></g>
                            </g>
                        </svg>
                        <!-- Equipment Labels -->
                        <div class="eq-label eq-pump">Bơm cấp liệu</div>
                        <div class="eq-label eq-mixer">Máy trộn</div>
                        <div class="eq-label eq-valve">Van xả đáy</div>
                        <!-- Sensor Overlays on Tank -->
                        <div class="tank-temp-card top-temp">
                            <div class="param-card-icon icon-red"><i class="fas fa-thermometer-half"></i></div>
                            <div class="param-card-info">
                                <div class="param-card-title">Nhiệt độ<br />bồn trộn trên</div>
                                <div class="param-card-value">
                                    <span id="TankDiagramTempTop">35.2</span> <small>°C</small>
                                </div>
                                <div class="param-card-std">Tiêu chuẩn: <span>40.0 °C</span></div>
                            </div>
                        </div>
                        <div class="tank-temp-card mid-temp">
